---
interface Props {
  active?: "home" | "expertise" | "projects" | "about" | "contact";
}

const { active } = Astro.props;

const links = [
  { href: "/", label: "Home", id: "home" },
  { href: "/expertise", label: "Expertise", id: "expertise" },
  { href: "/projects", label: "Projects", id: "projects" },
  { href: "/about", label: "About", id: "about" },
  { href: "/contact", label: "Contact", id: "contact" },
] as const;
---

<header class={active === "home" ? "is-home" : undefined}>
  <nav>
    <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">MM</a>

    <div class="navigation">
      {
        links.map((link) => (
          <a href={link.href} class={active === link.id ? "active-page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-menu-panel">
        {
          links.map((link) => (
            <a href={link.href} class={active === link.id ? "active-page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</header>

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    width: 100%;
  }

  nav {
    display: flex;
    width: min(1180px, calc(100% - 48px));
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
  }

  .logo {
    color: #45c7ff;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -4px;
    text-decoration: none;
    text-shadow: 0 0 20px rgba(69, 199, 255, 0.32);
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .navigation a,
  .mobile-menu-panel a {
    color: rgba(245, 247, 250, 0.78);
    font-size: 14px;
    text-decoration: none;
  }

  .navigation a:hover,
  .navigation a.active-page {
    color: #ffffff;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 760px) {
    header {
      position: relative;
    }

    header.is-home {
      position: absolute;
    }

    nav {
      width: min(100% - 30px, 1180px);
    }

    .navigation {
      display: none;
    }

    .mobile-menu {
      position: static;
      display: block;
    }

    .mobile-menu summary {
      position: relative;
      z-index: 32;
      display: grid;
      width: 42px;
      height: 42px;
      place-content: center;
      gap: 5px;
      border: 1px solid rgba(245, 247, 250, 0.26);
      border-radius: 4px;
      cursor: pointer;
      list-style: none;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu summary span {
      display: block;
      width: 18px;
      height: 2px;
      background: #f5f7fa;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    .mobile-menu[open]::before {
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgba(3, 12, 24, 0.58);
      content: "";
    }

    .mobile-menu[open] summary span:first-child {
      transform: translateY(7px) rotate(45deg);
    }

    .mobile-menu[open] summary span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu[open] summary span:last-child {
      transform: translateY(-7px) rotate(-45deg);
    }

    .mobile-menu-panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 31;
      display: grid;
      width: min(86vw, 340px);
      align-content: start;
      padding: 108px 22px 24px;
      border-left: 1px solid rgba(245, 247, 250, 0.15);
      background: #0b1c31;
      box-shadow: -16px 0 34px rgba(0, 0, 0, 0.32);
    }

    .mobile-menu-panel a {
      padding: 14px 12px;
      font-size: 15px;
    }

    .mobile-menu-panel a:hover,
    .mobile-menu-panel a.active-page {
      color: #ffffff;
      background: rgba(69, 199, 255, 0.12);
    }
  }
</style>